{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/styles.css",
      "destination": "/static/styles.css"
    }
  ],
  "headers": [
    {
      "source": "/static/styles.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
